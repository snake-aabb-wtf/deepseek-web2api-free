# DeepSeek API Proxy Configuration
# Copy this file to .env and fill in your credentials

# ── Client API authentication (/v1/*) ────────────────────────
# Required for public deployments. Clients should send either:
#   Authorization: Bearer <key>
# or:
#   x-api-key: <key>
API_KEYS=

# Optional single-key alias, also accepted by /v1/* auth.
# DEEPSEEK_API_KEY=sk-change-me

# Only for local development. Do NOT enable on a public server.
ALLOW_UNAUTHENTICATED_API=false

# ── DeepSeek account credentials ─────────────────────────────
# Get these from browser DevTools -> Network -> any request to chat.deepseek.com
# DEEPSEEK_TOKEN = "Authorization" header value after "Bearer "
# DEEPSEEK_COOKIES = "Cookie" header value
#
# Note on token format: DeepSeek's localStorage stores the token as a JSON
# wrapper like {"value":"<bare-token>","__version":"0"}, while the actual
# network request sends only <bare-token> after "Bearer ". The adapter
# accepts either form — paste whichever you copied and it will be unwrapped
# automatically.

# Numbered multi-account format. Env accounts are loaded on startup and are
# read-only in the web panel; edit .env and restart the service to change them.
DEEPSEEK_TOKEN_1=your_first_token_here
DEEPSEEK_COOKIES_1=your_first_cookies_here
DEEPSEEK_EMAIL_1=first-account

# DEEPSEEK_TOKEN_2=your_second_token_here
# DEEPSEEK_COOKIES_2=your_second_cookies_here
# DEEPSEEK_EMAIL_2=second-account

# Legacy single-account format is still supported.
# DEEPSEEK_TOKEN=your_token_here
# DEEPSEEK_COOKIES=your_cookies_here
# DEEPSEEK_EMAIL=env-default

# Panel-managed accounts are persisted to this JSON file.
# Keep this file private; it contains raw DeepSeek tokens and cookies.
ACCOUNT_STORE_PATH=data/accounts.json

# Server port (default: 8080)
PORT=8080

# Model name shown in API responses (doesn't affect actual model used)
MODEL_NAME=deepseek-chat

# Mode: "auto" (respect client), "quick" (force quick mode), "expert" (force expert mode)
# When set to "expert", all requests use expert mode regardless of client's thinking_mode
# When set to "quick", all requests use quick mode regardless of client's thinking_mode
MODE=auto

# Thinking: "auto" (respect client), "enabled" (force on), "disabled" (force off)
# Controls thinking_enabled independently of mode.
# MODE=quick + THINKING=enabled → quick mode with thinking/reasoning enabled
THINKING=auto

# Search / Web Search: "auto" (respect client), "enabled" (force on), "disabled" (force off)
# Controls search_enabled for web search capability.
SEARCH=auto

# Admin panel password (for /webui management interface)
# If not set, default is "admin". Change this before exposing the service.
# The server refuses to start on a public bind (HOST=0.0.0.0) with a weak
# password unless ALLOW_INSECURE_PUBLIC_DEFAULTS=true.
DEEPSEEK_ADMIN_PASSWORD=admin

# ── Bind address (v2.2.0) ─────────────────────────────────────
# Where to listen. Default is loopback for safety. Use 0.0.0.0 ONLY
# behind a reverse proxy that enforces auth.
HOST=127.0.0.1
# PORT=8080

# Acknowledge risk explicitly when binding publicly with default creds.
# Default false. Set true to bypass the startup safety check (NOT recommended).
ALLOW_INSECURE_PUBLIC_DEFAULTS=false

# ── CORS allow-list (v2.2.0) ──────────────────────────────────
# Comma-separated list of allowed origins for browser-based clients.
# Empty = same-origin only (the safe default).
# ALLOWED_ORIGINS=https://app.example.com,https://chat.example.com
# ALLOW_CORS_CREDENTIALS=true

# ── Trusted proxies (v2.2.0) ──────────────────────────────────
# Comma-separated list of IPs / CIDR ranges that are allowed to set
# X-Forwarded-For for the admin login throttle. Empty = no proxy is
# trusted, request.client.host is always used.
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8,::1

# ── Encryption key for data/accounts.json (v2.2.0) ────────────
# When set, DeepSeek tokens/cookies are encrypted at rest using Fernet
# (AES-128-CBC + HMAC-SHA256). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Existing plaintext files are auto-migrated to encrypted form on first
# startup; a `accounts.json.v1.bak` is left for rollback.
# DEEPSEEK_ENCRYPTION_KEY=

# ── Logging (v2.2.0) ──────────────────────────────────────────
# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# Log format: json (production) or text (development, default)
LOG_FORMAT=json

# ── Client rate limiting (v2.2.0) ─────────────────────────────
# Per-API-key requests-per-minute. 0 = unlimited.
CLIENT_RPM_PER_KEY=60
# Per-client-IP requests-per-minute. 0 = unlimited.
CLIENT_RPM_PER_IP=120
# Set false to disable all rate limiting (e.g. trusted internal network).
ENABLE_RATE_LIMIT=true

# ── Model routing (v2.2.0) ────────────────────────────────────
# JSON map from public model name (sent by clients in `model` field)
# to DeepSeek `model_type` ("default" | "expert"). When a client's
# model is not in this map, MODE / THINKING env vars apply.
MODEL_ROUTES={"deepseek-chat":"default","deepseek-reasoner":"expert"}

# ── Multi-turn conversation cache (v2.2.0) ────────────────────
# TTL (seconds) for the per-(api_key,user) chat_session cache that
# powers multi-turn conversations. 0 = always start a fresh session.
# Default raised to 1800 in v3.2.4 to keep long coding-agent sessions
# threaded. Cached turns send incremental (delta) prompts upstream
# instead of resending the full history (see AGENTS.md §5).
SESSION_CACHE_TTL=1800

# ── Upstream concurrency (v3.2.4) ─────────────────────────────
# Max number of simultaneous upstream DeepSeek calls across ALL
# accounts. Extra requests queue (wait) instead of failing. Coding
# agents (opencode, Claude Code, ...) spawn parallel sub-agents that
# otherwise flood DeepSeek and trigger account mutes. Min 1.
DEEPSEEK_MAX_CONCURRENCY=2

# ── Anti-detection ───────────────────────────────────────────
# TLS / JA3 impersonation profile. Passed to curl_cffi.Session.
# Pick a profile close to a current Chrome Stable to match what real users send.
# Values: chrome120, chrome123, chrome124, chrome131, chrome133, chrome136, ...
# (depends on the curl_cffi version installed). chrome131 is a safe default
# in mid-2026.
DEEPSEEK_IMPERSONATE=chrome131

# Per-account upstream proxy (optional). When set, the adapter for that
# account routes all DeepSeek calls through this proxy. Format: protocol+
# auth+host+port, e.g. http://user:pass@proxy.example.com:8080 or
# socks5://127.0.0.1:1080. Strongly recommended when using multiple
# accounts: pin each account to a stable residential exit so DeepSeek's
# risk engine doesn't see N accounts dialing from the same IP.
# DEEPSEEK_PROXY_1=http://127.0.0.1:7901
# DEEPSEEK_PROXY_2=http://127.0.0.1:7902

# Inter-call jitter (seconds). Sleep a small uniform-random delay before
# each upstream call to break perfectly-timed automation patterns and
# reduce the chance of tripping the upstream rate limiter.
# Default 0.4; set 0 to disable.
DEEPSEEK_JITTER_SECS=0.4

# Backoff delays (seconds) before retrying after an upstream rate limit
# (upstream responds with finish_reason=rate_limit_reached). Each entry
# consumes one retry; after the last one the request fails with 429.
# Comma-separated; empty disables retrying entirely.
DEEPSEEK_RATE_LIMIT_RETRY_DELAYS=5,15
